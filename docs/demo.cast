[20.1, "o", "\r\n   1  2026-03-02 09:30  7a3f1f9   Open the books for Acme Ltd\r\n      by Ada: abo init 'Acme Ltd' --currency EUR --vat none --git-name Ada --git-email ada@example.invalid\r\n   2  2026-03-02 09:30  ab20b25   Declare Equity:Capital\r\n      by Ada: abo account add -- Equity:Capital\r\n   3  2026-03-02 09:30  1cb359e   Book Capital paid in\r\n      by Ada: abo post --date=2026-03-02 '--desc=Capital paid in' -- 'Assets:Bank=1000 EUR' 'Equity:Capital=-1000 EUR'\r\n   4  2026-03-02 09:30  3662af1   Book Hosting\r\n      by Ada: abo post --date=2026-03-02 --desc=Hosting -- 'Expenses:General=20 EUR' 'Assets:Bank=-20 EUR'\r\n"]
